[Unit]
Description=KESHAV Dependency Intelligence API
After=network.target

[Service]
Type=notify
User=keshav
Group=keshav
WorkingDirectory=/opt/keshav
Environment="PATH=/opt/keshav/venv/bin"
Environment="HOST=0.0.0.0"
Environment="PORT=5000"
Environment="DEBUG=false"
Environment="MAX_CONTENT_MB=1"
ExecStart=/opt/keshav/venv/bin/gunicorn "api:app" \
    --workers 4 \
    --bind 0.0.0.0:5000 \
    --timeout 30 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --access-logfile - \
    --error-logfile - \
    --log-level info
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/keshav
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
